# Sai Jyothsna Caterers & Suppliers — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Server ---
# Port the app listens on (default: 3000)
PORT=3000
# Environment: development | production | test
NODE_ENV=development
# SQLite database file path (default: <project>/data/sai-jyothsna.db;
# on Vercel the DB lives in /tmp automatically — do not set DB_PATH there)
DB_PATH=

# --- Persistent database (Turso, free tier) — REQUIRED on Vercel for a real
# live app; without these, Vercel runs in demo mode with an ephemeral /tmp
# database and bookings/admin changes do not persist. Locally, leave both
# unset to use the local file database. See OWNER_SETUP.md step 1.
# Create a free database at turso.tech, then copy its URL + auth token here.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Cron keep-alive secret (Vercel cron) ---
# Vercel sets CRON_SECRET automatically when cron jobs are configured (see
# vercel.json) and sends it as the Authorization header to
# GET /api/cron/keep-alive. When set, that endpoint requires the header.
# Leave unset for local dev.
CRON_SECRET=

# --- Session signing secret (REQUIRED on Vercel) ---
# Sessions are stateless HMAC-signed cookies: every serverless instance must
# sign with the SAME secret, or logins break across instances. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random per-process secret is used (local dev only — sessions
# will not survive a restart). Never commit a real value.
SESSION_SECRET=

# --- First-run admin (used by the seed and `npm run reset-admin`) ---
# Defaults if unset: admin@saijyothsna.local / ChangeMe123!
# The seeded admin must change this password on first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email (SMTP) — used for admin notifications and password resets ---
# (admin + customer). If SMTP_HOST / SMTP_USER / SMTP_PASS are not set,
# notification emails are recorded in the notifications outbox as "pending"
# instead of being sent, and the customer "Forgot password?" link is hidden.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Google Sign-In (customer login) — free, no charges ---
# Create an OAuth client ID (Web application) in Google Cloud, set its
# authorized redirect URI to
#   https://sai-jyothsna-caterers.vercel.app/api/auth/google/callback
# (your own domain if you use one), then paste the client ID + secret here.
# Without these, the "Continue with Google" button is hidden and customers
# log in with email + password instead. See OWNER_SETUP.md step 3.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Override for the Google redirect URI (default: request origin +
# /api/auth/google/callback). Set this explicitly if the app runs behind a
# proxy that changes the origin Google sees.
GOOGLE_REDIRECT_URI=

# --- SMS (OTP delivery) — OPTIONAL; only needed if the owner wants OTP login ---
# Customers log in with email + password or Google without any of this.
# Channel priority: MSG91 -> Twilio -> WhatsApp (below) -> dev console log.
# If none is configured, the OTP login option is hidden from customers and
# OTPs are only logged to the server console (dev mode) with the API
# reporting devMode: true.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SAIJYO
MSG91_TEMPLATE_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- WhatsApp Cloud API (optional) ---
# Powers admin notifications AND (as the third OTP channel) WhatsApp OTPs.
# If unset, notifications still return a wa.me link for the owner to tap;
# no WhatsApp message is sent automatically.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name of the approved WhatsApp authentication template used for OTPs
# (default: sjc_otp_code). The owner must create + approve this template
# in Meta's WhatsApp Manager first — see OWNER_SETUP.md step 3.
WHATSAPP_OTP_TEMPLATE=sjc_otp_code
